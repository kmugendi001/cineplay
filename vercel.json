{
  "version": 2,
  "buildCommand": "npm install --prefix client && npm run build --prefix client && npm install --prefix server",
  "outputDirectory": "client/dist",
  "functions": {
    "api/[...slug].js": {
      "runtime": "@vercel/node@2.0.0"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...slug].js"
    },
    {
      "src": "/(.*)",
      "dest": "/client/dist/index.html"
    }
  ]
}
