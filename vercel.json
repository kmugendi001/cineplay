{
  "buildCommand": "npm run build --prefix client && npm install --prefix server",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "functions": {
    "server/**": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"]
    },
    {
      "src": "/(.*)",
      "dest": "client/dist/index.html"
    }
  ]
}
